# Used by EAS instead of .gitignore when uploading the build archive.
# Intentionally allows assets/ai-model/model.gguf so production AABs
# can ship the install-time Play Asset Delivery pack.

# dependencies
node_modules/

# expo
.expo/
dist/
web-build/
expo-env.d.ts

# VCS / editor / huge local junk (must stay out of the 2 GB upload cap)
.git/
.cursor/
agent-transcripts/
tmp/
tmp-*/
*.log

# native / secrets
*.orig.*
*.keystore
*.jks
keystore-credentials.txt
**/keystore-credentials.*
**/signing-credentials.*
**/*-upload-key.*
*.p8
*.p12
*.key
*.mobileprovision

# Local release outputs — never upload prior AAB/APK/APKS (multi-GB)
release/
**/*.apk
**/*.aab
**/*.apks

# generated native projects (recreated by `expo prebuild` on EAS)
/android/
/ios/

# metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store

# env
.env*.local

# typescript
*.tsbuildinfo

# tests
coverage/

# Keep other model sideload dirs out of the archive
assets/models/

# Marketing site (separate Next.js app) — not part of the Android AAB
website/
website/**
