{
  "expo": {
    "name": "Oppuna",
    "slug": "oppuna",
    "version": "2.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "oppuna",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#3D6B5A"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.oppuna.care",
      "buildNumber": "1",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Oppuna uses the microphone only to record private voice notes that stay on your device. Nothing is ever uploaded.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.oppuna.care",
      "versionCode": 9,
      "allowBackup": false,
      "softwareKeyboardLayoutMode": "resize",
      "userInterfaceStyle": "automatic",
      "adaptiveIcon": {
        "backgroundColor": "#3D6B5A",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.VIBRATE",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.SCHEDULE_EXACT_ALARM"
      ],
      "blockedPermissions": [
        "android.permission.INTERNET",
        "android.permission.INTERNET"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "newArchEnabled": true,
    "plugins": [
      "expo-localization",
      "expo-secure-store",
      [
        "llama.rn",
        {
          "enableEntitlements": true,
          "entitlementsProfile": "production",
          "forceCxx20": true,
          "enableOpenCL": true
        }
      ],
      "./plugins/withAiModelAssetPack.js",
      "./plugins/withAndroidPrivacy.js",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#3D6B5A",
          "image": "./assets/splash-icon.png",
          "imageWidth": 1
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Oppuna records private voice notes that never leave your device."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/android-icon-monochrome.png",
          "color": "#3D6B5A",
          "defaultChannel": "oppuna-care-reminders",
          "sounds": [],
          "enableBackgroundRemoteNotifications": false
        }
      ],
      "expo-asset",
      "expo-font"
    ],
    "extra": {
      "offlineOnly": true,
      "localLlm": {
        "provider": "llama.rn",
        "modelId": "oppuna-qwen25-1_5b-instruct-q4km",
        "displayName": "Qwen2.5 1.5B Instruct (Q4_K_M)",
        "assetPack": "ai_model_asset_pack",
        "modelFile": "model.gguf"
      },
      "eas": {
        "projectId": "0e59d96f-8d41-4a4d-98d2-9e6d26dbadef"
      }
    },
    "owner": "oppuna",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/0e59d96f-8d41-4a4d-98d2-9e6d26dbadef"
    }
  }
}
