# AssemblyAI Voice Agent key.
# The token server reads ASSEMBLYAI_API_KEY and never sends it to the app.
# A standalone phone build reads EXPO_PUBLIC_ASSEMBLYAI_API_KEY and embeds it
# in the app so the phone can mint tokens without a computer. Leave that unset
# unless you are building that APK. Do not commit a real key.
ASSEMBLYAI_API_KEY=your_assemblyai_api_key_here
# EXPO_PUBLIC_ASSEMBLYAI_API_KEY=

# Local token server.
# A phone cannot reach 127.0.0.1. For an on-device test, set
# VOICE_TOKEN_HOST=0.0.0.0 and point the app at http://<this-computer-lan-ip>:8787.
VOICE_TOKEN_PORT=8787
VOICE_TOKEN_HOST=127.0.0.1

# Expo reads this public URL. It is not a secret.
EXPO_PUBLIC_VOICE_TOKEN_URL=http://127.0.0.1:8787
