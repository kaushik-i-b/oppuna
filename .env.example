# Oppuna Voice — environment placeholders (NEVER commit real secrets)
#
# Oppuna is offline-first. Voice ("Talk to Oppuna") is the ONLY feature that
# touches the network, and only after explicit per-session user consent.
# The app never embeds a long-lived AssemblyAI API key. Instead a tiny
# server endpoint mints short-lived realtime tokens (see
# scripts/voice-token-server.js).

# Base URL of the token endpoint that returns { "token": "<temp token>" }.
# Example for local development: http://localhost:8787/api/voice-token
EXPO_PUBLIC_VOICE_TOKEN_URL=

# Optional: token TTL hint shown in diagnostics (seconds). Server decides.
EXPO_PUBLIC_VOICE_TOKEN_TTL=900

# --- Server side only (scripts/voice-token-server.js reads these) ---
# ASSEMBLYAI_API_KEY=
# VOICE_TOKEN_TTL_SECONDS=900
# PORT=8787

# --- Local demo fallback ---
# When no token endpoint is configured, "Talk to Oppuna" runs fully on-device
# (local transcription fallback + on-device reply engine). Nothing leaves the
# phone. Set this to 1 to also enable the clearly-labelled [DEMO] seed toggle
# on the voice screen for judge walkthroughs.
EXPO_PUBLIC_VOICE_DEMO_MODE=0
